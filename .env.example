# Azure AI Foundry Agent - Environment Variables
# Copy this file to .env and fill in the values.

# Azure AI Foundry Project endpoint
AZURE_AI_PROJECT_ENDPOINT=https://your-ai-account.services.ai.azure.com/api/projects/your-project

# Azure subscription and resource group
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group

# Azure AI account name (the Cognitive Services / AI Services resource)
AZURE_AI_ACCOUNT_NAME=your-ai-account-name

# Azure AD tenant ID (optional, for multi-tenant scenarios)
AZURE_TENANT_ID=

# Model deployment name (defaults to gpt-4o)
AZURE_MODEL_DEPLOYMENT=gpt-4o
